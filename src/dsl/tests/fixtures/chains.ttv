// `where` / `<|` / ordinal / range chains.
using DISCORD/779741119520571456
    await (.sender is "streamcord")
        // `where` binds tighter than `<|`, so this reads as 1st <| (.links where (...)).
        goto 1st <| .links where ("twitch.tv" in .href)
        // Negative ordinals count from the end.
        goto -1st <| .links where (.href is *)
        // The universal "th" suffix is legal: 3th means the same as 3rd.
        goto 3th <| .links
        // A `where` applied to the result of a `where`.
        goto 1st <| .links where (.href is *) where ("clips" in .href)
using *
    await 5:00
        // An exclusive range: 1 .. 10 runs 1 through 9.
        POST `rolled ${ any from (1 .. 10) }`
        // An inclusive range: 1 ... 10 runs 1 through 10.
        POST `rolled ${ any from (1 ... 10) }`
        // A newline-separated list.
        POST any from (
            `heads`
            `tails`
        )
    await (not (.muted is true)) and ((.sender is "mod") or (.sender is "admin"))
        REPLY `authorized`
    await (USERNAME in .message) or (USERNAME in .mentions)
        REPLY `you rang, ${ .sender }?`
