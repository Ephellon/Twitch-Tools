// Permission grants on a `using` header, and the fact that they never widen.

using [vip] +read:datetime
    await 1:00
        // The host maps `datetime.now` to `read:datetime`, which this header granted.
        POST `granted: ${ &datetime.now() }`

using [moderator] +eval:calc -- "Arithmetic in calc( )"
    await 1:10
        // `Math.random` is unmapped, so it needs `eval:js`. `+eval:calc` is a different
        // permission, not a smaller or larger one, so this fails loudly.
        POST `refused: ${ &Math.random() }`

using [subscriber] +read:html.*
    await 1:20
        // A wildcard covers one more level of its own resource — `read:html.text`,
        // `read:html.attributes`, … — and nothing else. It never reaches `eval:js`.
        POST `also refused: ${ &Math.random() }`
