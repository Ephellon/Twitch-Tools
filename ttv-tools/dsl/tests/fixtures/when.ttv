// Both shapes of `when`, and the `*` default.

using *
    await (.command is *)
        // SWITCH form. The `is` with nothing after it is what selects it; every case is a
        // value followed by `:` and its own block.
        when .command is
            "help":
                REPLY `switch: help`

            "gamble":
                REPLY `switch: gamble`

            // `*` is the default for free: comparing anything against the wildcard already
            // means "is present".
            *:
                REPLY `switch: other`

        // CHAIN form. A `when` written as the next sibling of an `if` continues it, which
        // is what this language has instead of `else if`.
        if .command is "help"
            REPLY `chain: help`
        when .command is "gamble"
            REPLY `chain: gamble`
        when .command is *
            REPLY `chain: other`

        // Not legal, and the error says so rather than complaining about a stray word:
        //     else if .command is "help"
        //         REPLY `nope`
