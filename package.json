{
    "name": "ttv-tools",
    "private": true,
    "scripts": {
        "build": "node scripts/build.mjs",
        "lint": "eslint",
        "format": "eslint --fix",
        "test": "node src/dsl/tests/run.js && node src/dsl/host/host-conformance.test.js && node --no-warnings src/dsl/host/extension-adapter.test.mjs && node --test \"src/lib/tests/*.test.mjs\" \"src/settings/tests/*.test.mjs\"",
        "lint:firefox": "web-ext lint --source-dir dist/firefox",
        "watch": "node scripts/build.mjs --watch"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@stylistic/eslint-plugin": "^5.10.0",
        "esbuild": "^0.28.2",
        "eslint": "^10.11.0",
        "globals": "^17.12.0",
        "playwright-core": "1.56",
        "web-ext": "^10.7.0"
    }
}
